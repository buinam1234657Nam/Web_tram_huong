# Public origin once a custom domain is live (see src/lib/config/site.ts)
# NEXT_PUBLIC_SITE_URL=https://vinhtram.vn

# Bank account for transfers and VietQR (see src/lib/config/payment.ts).
# Without NEXT_PUBLIC_BANK_ACCOUNT_NUMBER checkout shows a sample account and a warning.
NEXT_PUBLIC_BANK_NAME=Vietcombank
# NAPAS BIN of the bank, e.g. 970436 Vietcombank, 970415 VietinBank, 970418 BIDV, 970422 MB
NEXT_PUBLIC_BANK_BIN=970436
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
# As printed by the bank, uppercase without diacritics
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
